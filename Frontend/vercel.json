{
  "redirects": [
    {
      "source": "/app",
      "has": [
        { "type": "query", "key": "brokerAccounts", "value": "1" },
        { "type": "query", "key": "ctrader" }
      ],
      "destination": "/account.html?mode=login",
      "permanent": false
    },
    {
      "source": "/app/",
      "has": [
        { "type": "query", "key": "brokerAccounts", "value": "1" },
        { "type": "query", "key": "ctrader" }
      ],
      "destination": "/account.html?mode=login",
      "permanent": false
    },
    { "source": "/app", "destination": "/app.html", "permanent": false },
    { "source": "/app/", "destination": "/app.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/proxy/:path*", "destination": "/api/backend-proxy?path=:path*" }
  ],
  "headers": [
    {
      "source": "/app.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/startup.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/user-auth.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/tab-role-session.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
