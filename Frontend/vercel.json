{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "header", "key": "host", "value": "flowsignalfx.com" }
      ],
      "destination": "https://www.nathauxfx.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "header", "key": "host", "value": "www.flowsignalfx.com" }
      ],
      "destination": "https://www.nathauxfx.com/:path*",
      "permanent": true
    },
    {
      "source": "/app",
      "has": [
        { "type": "query", "key": "brokerAccounts", "value": "1" },
        { "type": "query", "key": "ctrader", "value": "connected" }
      ],
      "destination": "/ctrader-return.html?ctrader=connected",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [
        { "type": "query", "key": "brokerAccounts", "value": "1" },
        { "type": "query", "key": "ctrader", "value": "error" }
      ],
      "destination": "/ctrader-return.html?ctrader=error",
      "permanent": false
    },
    {
      "source": "/app/",
      "has": [
        { "type": "query", "key": "brokerAccounts", "value": "1" },
        { "type": "query", "key": "ctrader", "value": "connected" }
      ],
      "destination": "/ctrader-return.html?ctrader=connected",
      "permanent": false
    },
    {
      "source": "/app/",
      "has": [
        { "type": "query", "key": "brokerAccounts", "value": "1" },
        { "type": "query", "key": "ctrader", "value": "error" }
      ],
      "destination": "/ctrader-return.html?ctrader=error",
      "permanent": false
    },
    { "source": "/app", "destination": "/app.html", "permanent": false },
    { "source": "/app/", "destination": "/app.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/proxy/:path*", "destination": "/api/backend-proxy?path=:path*" }
  ],
  "headers": [
    {
      "source": "/app.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/ctrader-return.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/startup.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/user-auth.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/tab-role-session.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
